# Jayah — environment template
# Copy to .env and fill in. NEVER commit real keys.
#
# Secrets can also live outside the repo in $JAYAH_HOME/jayah.env
# (default: ~/.jayah/jayah.env). The loader reads .env first, then that
# private file. The process environment always wins.

# --- Chat backend (any OpenAI-compatible endpoint) ---
# Examples: a local Ollama / vLLM server, or any hosted OpenAI-compatible API.
JAYAH_BASE_URL=
JAYAH_API_KEY=

# --- Model per tier (ids served by your backend) ---
JAYAH_MODEL_FAST=
JAYAH_MODEL_REASONING=
JAYAH_MODEL_HEAVY=

# --- Optional: research tier via Tavily ---
# TAVILY_API_KEY=

# --- Optional: local Qdrant for the context provider ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Local home (memory, tasks, logs). Nothing here leaves the machine. ---
JAYAH_HOME=~/.jayah
